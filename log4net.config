<?xml version="1.0" encoding="utf-8" ?>
<log4net>
  <!-- Define an appender that writes to a file -->
  <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="Logs/MyApplication.log" />
    <appendToFile>true</appendToFile>
    <rollingStyle>Size</rollingStyle>
    <maxSizeRollBackups>10</maxSizeRollBackups>
    <maximumFileSize>10MB</maximumFileSize>
    <staticLogFileName>true</staticLogFileName>
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%-5level %date [%thread] %logger - %message%newline" />
    </layout>
  </appender>

  <!-- Set the root logger level and add the appender -->
  <root>
    <!-- Possible levels: DEBUG, INFO, WARN, ERROR, FATAL -->
    <level value="DEBUG" />
    <appender-ref ref="RollingFileAppender" />
  </root>
</log4net>
